.meal {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
}

.hero {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.hero-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero-slot {
  font-size: 36rpx;
  font-weight: 600;
}

.hero-date {
  font-size: 26rpx;
  color: #888;
}

.hero-badge {
  margin-left: auto;
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
}

.hero-badge.ongoing {
  background: #e8f8ee;
  color: #07c160;
}

.hero-badge.closed {
  background: #f4f4f5;
  color: #888;
}

.hero-badge.prepared {
  background: #fff7e6;
  color: #b8860b;
}

.hero-countdown {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}

.hero-countdown-label {
  font-size: 24rpx;
  color: #888;
}

.hero-countdown-time {
  font-size: 40rpx;
  font-weight: 600;
  color: #fa5151;
  font-variant-numeric: tabular-nums;
}

.hero-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #888;
}

.close-early-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.close-early-hint {
  font-size: 24rpx;
  color: #888;
  flex: 1;
}

.close-early-btn {
  font-size: 26rpx;
  color: #fa5151;
  border: 1rpx solid #fa5151;
  border-radius: 28rpx;
  padding: 10rpx 32rpx;
}

.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #1f2329;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title-row .section-title {
  margin-bottom: 0;
}

.view-switcher {
  display: flex;
  background: #f7f8fa;
  border-radius: 16rpx;
  overflow: hidden;
}

.view-btn {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: #666;
}

.view-btn.active {
  background: #07c160;
  color: #fff;
}

.cancel-link {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 400;
  color: #fa5151;
}

.sum-row {
  padding: 14rpx 0;
  border-bottom: 2rpx solid #f2f3f5;
}

.sum-row:last-child {
  border-bottom: none;
}

.sum-row-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sum-dish {
  font-size: 30rpx;
  font-weight: 500;
}

.sum-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  background: #f4f4f5;
  color: #888;
}

.sum-tag.removed {
  background: #fff1f0;
  color: #fa5151;
}

.sum-qty {
  margin-left: auto;
  font-size: 28rpx;
  color: #fa5151;
  font-weight: 600;
}

.sum-people {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #888;
}

.ing-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 10rpx 0;
  border-top: 2rpx dashed #f2f3f5;
  font-size: 26rpx;
}

.ing-name {
  color: #1f2329;
}

.ing-amount {
  color: #888;
  text-align: right;
}

.mine-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 28rpx;
}

.mine-qty {
  color: #fa5151;
  font-weight: 600;
}

.mine-note {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
}

.empty-tip {
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #999;
  text-align: center;
}

.empty-tip .empty-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #bbb;
}

.dish-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f2f3f5;
}

.dish-card:last-child {
  border-bottom: none;
}

.dish-card.minimal {
  padding: 14rpx 0;
}

.dish-body {
  flex: 1;
  min-width: 0;
}

.dish-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
}

.dish-ingredients {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.step-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #e8f8ee;
  color: #07c160;
  font-size: 34rpx;
  line-height: 52rpx;
  text-align: center;
}

.step-btn.step-disabled {
  background: #f4f4f5;
  color: #ccc;
}

.step-qty {
  min-width: 40rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.readonly-qty-text {
  font-size: 24rpx;
  color: #07c160;
}

.floating-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #1f2329;
  border-radius: 48rpx;
  padding: 16rpx 16rpx 16rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.floating-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.floating-count {
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.floating-divider {
  color: #666;
  font-size: 24rpx;
}

.floating-total {
  color: #ccc;
  font-size: 26rpx;
}

.floating-btn {
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  padding: 14rpx 36rpx;
  border-radius: 40rpx;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 10;
}

.panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  z-index: 11;
  box-sizing: border-box;
}

.panel-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 600;
}

.panel-close {
  margin-left: auto;
  font-size: 26rpx;
  color: #888;
}

.panel-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f2f3f5;
}

.panel-name {
  font-size: 28rpx;
}

.note-input {
  margin: 24rpx 0;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
}

.confirm-btn {
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  border-radius: 48rpx;
}

.confirm-btn.disabled {
  opacity: 0.5;
}