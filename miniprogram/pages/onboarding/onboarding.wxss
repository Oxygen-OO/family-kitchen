.onboarding {
  min-height: 100vh;
  padding: 64rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.hero {
  margin-bottom: 64rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #333;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
}

.form {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  border-radius: 50%;
  overflow: hidden;
  background: #e5e6eb;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
}

.avatar-placeholder {
  font-size: 72rpx;
  color: #c0c4cc;
  line-height: 160rpx;
}

.avatar-hint {
  font-size: 24rpx;
  color: #bbb;
  margin-bottom: 24rpx;
}

.nickname-input {
  width: 100%;
  height: 96rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.save-btn {
  width: 100%;
  margin-top: 24rpx;
  background: #07c160;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
}

.family-hint {
  margin-top: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.family-title {
  font-size: 28rpx;
  color: #666;
}

.family-subtitle {
  font-size: 24rpx;
  color: #bbb;
}