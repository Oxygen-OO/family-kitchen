<view class="onboarding">
  <view class="hero">
    <text class="title">欢迎来到家庭厨房</text>
    <text class="subtitle">先完善你的身份信息，再与家人共享菜单</text>
  </view>

  <view class="form">
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image class="avatar" wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" />
      <text class="avatar-placeholder" wx:else>+</text>
    </button>
    <text class="avatar-hint">点击选择头像</text>

    <input
      class="nickname-input"
      type="nickname"
      placeholder="请输入昵称"
      value="{{nickname}}"
      bindinput="onNicknameInput"
    />

    <button class="save-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="onSaveProfile">
      保存
    </button>
  </view>

  <view class="family-hint">
    <text class="family-title">加入家人</text>
    <text class="family-subtitle">创建或加入家庭后即可开始点餐</text>
  </view>

  <view class="family-panel">
    <view class="panel-card">
      <text class="panel-title">创建家庭</text>
      <input
        class="panel-input"
        placeholder="家庭名称（2–12 个字符）"
        maxlength="12"
        value="{{familyName}}"
        bindinput="onFamilyNameInput"
      />
      <button class="panel-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onCreateFamily">
        创建
      </button>
    </view>

    <view class="panel-card">
      <text class="panel-title">加入家庭</text>
      <input
        class="panel-input"
        placeholder="6 位邀请码"
        maxlength="6"
        value="{{inviteCode}}"
        bindinput="onInviteCodeInput"
      />
      <button class="panel-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onJoinFamily">
        加入
      </button>
    </view>
  </view>
</view>