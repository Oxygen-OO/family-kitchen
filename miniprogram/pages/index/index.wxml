<view class="index">
  <view class="header">
    <text class="greeting" wx:if="{{nickname}}">{{nickname}}，欢迎回来</text>
    <text class="greeting" wx:else>家庭厨房</text>
  </view>

  <view class="switcher" wx:if="{{families.length > 0}}">
    <text class="switcher-title">我的家庭</text>
    <view class="switcher-list">
      <view
        wx:for="{{families}}"
        wx:key="family_id"
        class="switcher-item {{item.family_id === currentFamilyId ? 'active' : ''}} {{item.status !== 'active' ? 'frozen' : ''}}"
        data-id="{{item.family_id}}"
        bindtap="onSwitchFamily"
      >
        <text class="switcher-name">{{item.name}}</text>
        <text class="switcher-role" wx:if="{{item.my_role === 'creator'}}">立家者</text>
        <text class="switcher-role frozen-tag" wx:elif="{{item.status !== 'active'}}">已冻结</text>
      </view>
    </view>
  </view>

  <view class="family-card" wx:if="{{currentFamilyId}}">
    <text class="family-label">当前家庭</text>
    <text class="family-name">{{currentFamilyName}}</text>
    <button
      class="invite-btn"
      loading="{{inviting}}"
      disabled="{{inviting}}"
      bindtap="onInvite"
    >邀请家人</button>
    <button
      class="menu-btn"
      bindtap="onOpenMenu"
    >家庭菜单</button>
    <view class="meal-entry">
      <text class="meal-entry-title">今日餐次</text>
      <view class="meal-slots">
        <view
          class="meal-slot"
          wx:for="{{mealSlots}}"
          wx:key="slot"
          data-slot="{{item.slot}}"
          bindtap="onEnterMeal"
        >{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <text class="empty-title">还没有可用家庭</text>
    <text class="empty-subtitle">创建或加入家庭后即可开始共享菜单</text>
  </view>
</view>