.index {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 48rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 48rpx;
}

.greeting {
  font-size: 44rpx;
  font-weight: 600;
  color: #333;
}

.switcher {
  margin-bottom: 32rpx;
}

.switcher-title {
  font-size: 24rpx;
  color: #999;
}

.switcher-list {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.switcher-item {
  padding: 16rpx 24rpx;
  border-radius: 40rpx;
  background: #fff;
  border: 2rpx solid #e5e6eb;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.switcher-item.active {
  border-color: #07c160;
  background: #e8f9ef;
}

.switcher-item.frozen {
  opacity: 0.5;
}

.switcher-name {
  font-size: 28rpx;
  color: #333;
}

.switcher-role {
  font-size: 20rpx;
  color: #07c160;
}

.frozen-tag {
  color: #999;
}

.family-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.family-label {
  font-size: 24rpx;
  color: #999;
}

.family-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.invite-row {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
}

.invite-btn {
  flex: 1;
  background: #07c160;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.share-btn {
  flex: 1;
  background: #fff;
  color: #07c160;
  border: 2rpx solid #07c160;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.menu-btn {
  margin-top: 16rpx;
  background: #fff;
  color: #07c160;
  border: 2rpx solid #07c160;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.members-btn {
  margin-top: 16rpx;
  background: #fff;
  color: #576b95;
  border: 2rpx solid #576b95;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.prep-btn {
  margin-top: 16rpx;
  background: #fff;
  color: #b8860b;
  border: 2rpx solid #b8860b;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.meal-entry {
  margin-top: 24rpx;
  border-top: 2rpx solid #f2f3f5;
  padding-top: 24rpx;
}

.meal-entry-title {
  font-size: 24rpx;
  color: #999;
}

.meal-slots {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
}

.meal-slot {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  background: #f7f8fa;
  color: #07c160;
  font-size: 30rpx;
  font-weight: 500;
}

.empty {
  margin-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.empty-title {
  font-size: 30rpx;
  color: #666;
}

.empty-subtitle {
  font-size: 24rpx;
  color: #bbb;
}