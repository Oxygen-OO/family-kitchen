.dishes {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx;
  box-sizing: border-box;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.search {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  border: 2rpx solid #e5e6eb;
}

.view-switcher {
  display: flex;
  background: #fff;
  border: 2rpx solid #e5e6eb;
  border-radius: 16rpx;
  overflow: hidden;
}

.view-btn {
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  color: #666;
}

.view-btn.active {
  background: #07c160;
  color: #fff;
}

.tag-bar {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.tag-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.tag-chip {
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  background: #fff;
  border: 2rpx solid #e5e6eb;
  font-size: 24rpx;
  color: #666;
}

.tag-chip.active {
  background: #e8f9ef;
  border-color: #07c160;
  color: #07c160;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.removed-link {
  font-size: 26rpx;
  color: #999;
}

.add-btn {
  margin: 0;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: #07c160;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}

/* 大图视图 */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.card-img {
  width: 100%;
  height: 320rpx;
}

.card-img-empty {
  background: #f0f1f3;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-img-text {
  font-size: 40rpx;
  color: #bbb;
}

.card-body {
  padding: 24rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.card-tag {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: #e8f9ef;
  color: #07c160;
  font-size: 22rpx;
}

.card-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #888;
}

.card-ingredients {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.card-actions {
  display: flex;
  gap: 32rpx;
  margin-top: 20rpx;
}

.card-action {
  font-size: 26rpx;
  color: #07c160;
}

.card-action.danger {
  color: #fa5151;
}

/* 小图视图 */
.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.row-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.row-img-empty {
  background: #f0f1f3;
  display: flex;
  align-items: center;
  justify-content: center;
}

.row-img-text {
  font-size: 44rpx;
  color: #bbb;
}

.row-body {
  flex: 1;
  min-width: 0;
}

.row-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.row-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.row-off {
  font-size: 20rpx;
  color: #999;
  border: 2rpx solid #e5e6eb;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.row-ingredients {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 极简视图 */
.minimal {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}

.minimal-name {
  font-size: 28rpx;
  color: #333;
}

.minimal-name.off {
  color: #bbb;
  text-decoration: line-through;
}

.minimal-tags {
  font-size: 22rpx;
  color: #999;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.minimal-switch {
  flex-shrink: 0;
  transform: scale(0.75);
}

.minimal-actions {
  display: flex;
  gap: 24rpx;
  flex-shrink: 0;
}

.empty {
  margin-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.empty-title {
  font-size: 30rpx;
  color: #666;
}

.empty-subtitle {
  font-size: 24rpx;
  color: #bbb;
}