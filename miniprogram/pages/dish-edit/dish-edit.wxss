.edit {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx;
  box-sizing: border-box;
}

.field {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.required {
  color: #fa5151;
  margin-left: 4rpx;
}

.input {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  border: 2rpx solid #e5e6eb;
}

.textarea {
  width: 100%;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  min-height: 140rpx;
  border: 2rpx solid #e5e6eb;
}

.image-picker {
  height: 200rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-picker-text {
  font-size: 26rpx;
  color: #999;
}

.image-field {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.image-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.image-btn {
  font-size: 26rpx;
  color: #07c160;
}

.image-btn.danger {
  color: #fa5151;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-add {
  font-size: 26rpx;
  color: #07c160;
}

.ingredient-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.ingredient-input {
  flex: 1;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
  border: 2rpx solid #e5e6eb;
}

.ingredient-input.amount {
  flex: 1.2;
}

.row-remove {
  font-size: 24rpx;
  color: #fa5151;
  padding: 8rpx;
}

.field-hint {
  display: block;
  font-size: 24rpx;
  color: #bbb;
}

.tag-pool {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-chip {
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  background: #f7f8fa;
  border: 2rpx solid #e5e6eb;
  font-size: 24rpx;
  color: #666;
}

.tag-chip.active {
  background: #e8f9ef;
  border-color: #07c160;
  color: #07c160;
}

.custom-tag {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.custom-input {
  flex: 1;
}

.custom-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
}

.save-btn {
  background: #07c160;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
}